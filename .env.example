# Full Wave Forms multi-step embed (steps 1–3 hosted externally)
# VITE_WAVE_FORMS_EMBED_URL=https://your-wave-forms-instance.com/embed/your-form-id

# Built-in flow fallback — step 3 Zoom scheduler iframe
# VITE_WAVE_FORMS_ZOOM_EMBED_URL=https://scheduler.zoom.us/...

# Optional webhook when built-in flow completes step 2
# VITE_WAVE_FORMS_WEBHOOK_URL=https://your-wave-forms-instance.com/api/webhook
